# =========================================================================
# DeepShield - Configuration Front-end PHP
# Copiez ce fichier en ".env" puis adaptez les valeurs à votre poste/serveur.
# Aucun chemin n'est codé en dur dans le code (exigence 5.3 du cahier des
# charges) : tout passe par ces variables.
# =========================================================================

# --- Sécurité minimale (exigence 4.4 : authentification par clé API) -----
# Clé à saisir dans le formulaire de connexion du dashboard.
DEEPSHIELD_API_KEY=demo-key-change-me

# --- Moteur d'analyse -----------------------------------------------------
# Chemin vers l'exécutable Python à utiliser pour lancer le pipeline.
# Sur Windows : DEEPSHIELD_PYTHON_BIN=py
DEEPSHIELD_PYTHON_BIN=python3

# Mode démonstration : à 1, le bridge Python simule un résultat réaliste
# sans charger de modèle (pas de PyTorch/OpenCV nécessaires). Permet de
# faire tourner le dashboard de bout en bout pour la démo (exigence 5.4)
# même si l'environnement ML n'est pas installé sur le poste.
# Mettre à 0 pour utiliser le vrai moteur (nécessite torch, transformers,
# opencv-python, les poids du modèle et le détecteur de visage YuNet).
DEEPSHIELD_MOCK_MODE=1

# Nombre de frames extraites par défaut par vidéo analysée
DEEPSHIELD_MAX_FRAMES=30

# Seuil de décision réel/deepfake, en % de score "réel" (voir 4.3 :
# seuils calibrés et documentés, à ajuster après la phase d'évaluation)
DEEPSHIELD_THRESHOLD=50

# Dossier de cache des modèles HuggingFace / poids du détecteur de visage
DEEPSHIELD_MODEL_CACHE_DIR=./storage/models

# Dossier de travail temporaire (frames extraites, visages recadrés)
DEEPSHIELD_TEMP_DIR=./storage/tmp

# --- Fichiers ---------------------------------------------------------
# Taille max acceptée par upload, en octets (200 Mo par défaut)
DEEPSHIELD_MAX_UPLOAD_BYTES=209715200

# Extensions autorisées (voir périmètre 3.1)
DEEPSHIELD_VIDEO_EXT=mp4,mov
DEEPSHIELD_AUDIO_EXT=wav,mp3

# --- Confidentialité (exigence 5.2) --------------------------------------
# Si à 1, les fichiers uploadés (vidéo/audio, donnée biométrique) sont
# supprimés automatiquement après analyse, sauf si l'utilisateur coche
# explicitement "conserver pour ré-entraînement" dans le formulaire.
DEEPSHIELD_AUTO_DELETE_UPLOADS=1

# --- Sécurité (déconnexion automatique après inactivité) -----------------
# Délai d'inactivité, en secondes, avant expiration automatique de la
# session (protection "anti-AFK"). 900 = 10 minutes.
SESSION_IDLE_TIMEOUT=600

# --- Base de données (authentification + historique des vidéos) ---------
# Correspond au dump deepshield_bdd.sql (tables users, videos, login_attempts).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=deepshield
DB_USER=root
DB_PASS=
